#include <stdio.h>

char s[100];
int i = 0;

void S();
void L();

void S() {
    if(s[i] == 'a') {
        i++;
    }
    else if(s[i] == '(') {
        i++;
        L();

        if(s[i] == ')')
            i++;
        else
            return;
    }
}

void L() {
    S();

    while(s[i] == ',') {
        i++;
        S();
    }
}

int main() {
    printf("Enter string: ");
    scanf("%s", s);

    S();

    if(s[i] == '\0')
        printf("Valid String");
    else
        printf("Invalid String");

    return 0;
}


