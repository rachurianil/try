#include <stdio.h>
#define MAX 5

int s[MAX], top=-1;

void allocate(int x) {
    if (top==MAX-1) printf("Overflow\n");
    else s[++top]=x;
}

void deallocate() {
    if (top==-1) printf("Underflow\n");
    else printf("Deallocated: %d\n",s[top--]);
}

void display() {
    int i;
    for (i=0;i<=top;i++) printf("%d ",s[i]);
    printf("\n");
}

int main() {
    allocate(10);
    allocate(20);
    allocate(30);
    display();
    deallocate();
    display();
    return 0;
}

