#include<stdio.h>
#include<string.h>
struct SymbolTable{
    char name[20];
    char type[20];
};
int main(){
    struct SymbolTable st[10];
    int n;
    printf("Enter the number of symbols: ");
    scanf("%d",&n);

    for(int i=0;i<n;i++){
        printf("Enter the name of symbol %d: ",i+1);
        scanf("%s",st[i].name);
        printf("Enter the type of symbol %d: ",i+1);
        scanf("%s",st[i].type);
    }

    printf("\nSymbol Table:\n");

    printf("Name\tType\n");
    for(int i=0;i<n;i++){
        printf("%s\t%s\n",st[i].name,st[i].type);
    }
}

