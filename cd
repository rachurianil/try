//lexical analyzer

#include<stdio.h>
#include<ctype.h>

int main(){
    char str[100];
    int i=0;

    printf("Enter the String: ");
    scanf("%[^\n]", str);

    while(str[i]!='\0'){

        if(isalpha(str[i])){
            printf("Identifier: ");
            while(isalnum(str[i])){
                printf("%c",str[i++]);
            }
            printf("\n");
        }
        else if(isdigit(str[i])){
            printf("Constant: ");
            while(isalnum(str[i])){
                printf("%c",str[i++]);
            }
            printf("\n");
        }
        else if((str[i])=='+' || str[i]=='-' || str[i]=='/' ||str[i]=='*'){
            printf("Operator: %c",str[i]);
            printf("\n");
            i++;
                
        }
        else{
            i++;
        }

    }
}


